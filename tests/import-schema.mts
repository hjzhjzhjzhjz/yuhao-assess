/**
 * 方案導入 Zod 校驗層測試
 *
 * 覆蓋：
 * - 合法方案（含全部 5 類測評結果）通過
 * - 缺失方案骨架字段 / 類型錯誤 → 拒絕且錯誤含字段路徑
 * - 測評結果某一類損壞 → 只跳過那一類，方案仍通過
 * - 舊版方案缺可選字段 → 補全默認值
 * - 未知結果字段（候選個數分析等）原樣保留
 * - JSON 語法錯誤 → 友好中文提示
 *
 *   pnpm exec tsx tests/import-schema.mts
 */
import { 解析導入JSON } from '../src/schemas/importScheme.ts'

let 通過 = 0
let 失敗 = 0

function 斷言(條件: boolean, 說明: string) {
  if (條件) {
    通過++
  } else {
    失敗++
    console.error(`  ✗ ${說明}`)
  }
}

/** 構造一份最小但合法的方案（不含測評結果） */
function 合法方案(覆蓋: Record<string, unknown> = {}) {
  return {
    元數據: {
      方案名: '測試方案',
      標識符: 'test',
      版本: '1.0.0',
      創建時間: '2024-01-01T00:00:00.000Z',
      更新時間: '2024-01-01T00:00:00.000Z',
    },
    方案參數: { 最大碼長: 4 },
    ...覆蓋,
  }
}

const 字符集數據 = {
  全碼重碼組數: 1,
  簡碼重碼組數: 2,
  全碼重碼字數: 3,
  簡碼重碼字數: 4,
  實際字符數: 5,
  理論字符數: 6,
  字集覆蓋率: 0.8,
}
const 靜態結果 = {
  GB2312: 字符集數據,
  通用規範: 字符集數據,
  常用國字: 字符集數據,
  CJK基本: 字符集數據,
  到CJK擴A: 字符集數據,
  到CJK擴B: 字符集數據,
  到CJK擴C: 字符集數據,
  到CJK擴D: 字符集數據,
  到CJK擴E: 字符集數據,
  到CJK擴F: 字符集數據,
  到CJK擴G: 字符集數據,
  到CJK擴H: 字符集數據,
  到CJK擴I: 字符集數據,
  到CJK擴J: 字符集數據,
}
const 動態結果 = { 知乎簡體動態選重率: { 全碼: 0.1, 簡碼: 0.2 } }
const 速度結果 = { 知乎簡體字頻全碼速度當量: 1.5 }
const 簡碼結果 = {
  知乎簡體字頻下之簡碼效率: {
    完整字符字符串: 'abc',
    N值結果: [{ 最有效率的簡碼個數: 0, 字頻加權碼長: 4.2 }],
  },
}
const 熱力結果 = { 全碼: { a: 1 }, 簡碼: { b: 2 } }

console.log('=== 場景 1：合法方案 + 全部 5 類測評結果 ===')
{
  const 方案 = 合法方案({
    測評結果: {
      靜態重碼分析: 靜態結果,
      動態選重分析: 動態結果,
      速度當量分析: 速度結果,
      簡碼效率分析: 簡碼結果,
      鍵位熱力: 熱力結果,
    },
  })
  const r = 解析導入JSON(JSON.stringify(方案))
  斷言(r.成功, '合法方案應通過')
  if (r.成功) {
    斷言(r.測評結果.靜態重碼分析 !== undefined, '靜態重碼應被載入')
    斷言(r.測評結果.動態選重分析 !== undefined, '動態選重應被載入')
    斷言(r.測評結果.速度當量分析 !== undefined, '速度當量應被載入')
    斷言(r.測評結果.簡碼效率分析 !== undefined, '簡碼效率應被載入')
    斷言(r.測評結果.鍵位熱力 !== undefined, '鍵位熱力應被載入')
    斷言(r.跳過的結果.length === 0, '不應有任何跳過項')
  }
}

console.log('=== 場景 2：缺失骨架字段 → 拒絕且錯誤含字段路徑 ===')
{
  const r = 解析導入JSON(JSON.stringify({ 元數據: { 方案名: 'x' }, 方案參數: { 最大碼長: 0 } }))
  斷言(!r.成功, '缺字段的方案應被拒絕')
  if (!r.成功) {
    斷言(r.錯誤.includes('元數據.標識符'), '錯誤應含「元數據.標識符」路徑')
    斷言(r.錯誤.includes('最大碼長'), '錯誤應含「最大碼長」')
    斷言(r.錯誤.includes('正整數'), '最大碼長錯誤應說明「正整數」')
  }
}

console.log('=== 場景 3：測評結果局部損壞 → 只跳過損壞項 ===')
{
  const 方案 = 合法方案({
    測評結果: {
      靜態重碼分析: 靜態結果,
      速度當量分析: { 知乎簡體字頻全碼速度當量: '坏值' }, // 損壞
      鍵位熱力: 熱力結果,
    },
  })
  const r = 解析導入JSON(JSON.stringify(方案))
  斷言(r.成功, '單項結果損壞時方案仍應通過')
  if (r.成功) {
    斷言(r.測評結果.靜態重碼分析 !== undefined, '合法的靜態重碼應被保留')
    斷言(r.測評結果.鍵位熱力 !== undefined, '合法的鍵位熱力應被保留')
    斷言(r.測評結果.速度當量分析 === undefined, '損壞的速度當量應被跳過')
    斷言(r.跳過的結果.includes('速度當量分析'), '跳過列表應含速度當量分析')
  }
}

console.log('=== 場景 4：舊版方案缺可選字段 → 補全默認值 ===')
{
  const r = 解析導入JSON(JSON.stringify(合法方案()))
  斷言(r.成功, '舊版方案應通過')
  if (r.成功) {
    const p = r.方案.方案參數 as Record<string, unknown>
    斷言(p.選重編碼化 === false, '選重編碼化應補全為 false')
    斷言(p.出簡不出全 === false, '出簡不出全應補全為 false')
    斷言(
      JSON.stringify(p.選重鍵表) === JSON.stringify({ '2': ';', '3': "'" }),
      '選重鍵表應補全默認值'
    )
  }
}

console.log('=== 場景 5：未知結果字段原樣保留 ===')
{
  const 方案 = 合法方案({
    測評結果: {
      靜態重碼分析: 靜態結果,
      候選個數分析: { 自定義: 42 },
      連續文本當量: { 統計: { 平均數: 1.36 } },
    },
  })
  const r = 解析導入JSON(JSON.stringify(方案))
  斷言(r.成功, '含未知字段的方案應通過（passthrough）')
  if (r.成功) {
    斷言(r.未知結果字段.候選個數分析 !== undefined, '候選個數分析應被保留')
    斷言(r.未知結果字段.連續文本當量 !== undefined, '連續文本當量應被保留')
  }
}

console.log('=== 場景 6：JSON 語法錯誤 → 友好提示 ===')
{
  const r = 解析導入JSON('{ bad json')
  斷言(!r.成功, '語法錯誤應被拒絕')
  if (!r.成功) 斷言(r.錯誤.includes('JSON 格式錯誤'), '錯誤應含「JSON 格式錯誤」')
}

console.log('=== 場景 7：錯誤信息全中文（無英文 Invalid input）===')
{
  const r = 解析導入JSON(JSON.stringify({ 元數據: {}, 方案參數: {} }))
  斷言(!r.成功, '空骨架應被拒絕')
  if (!r.成功) {
    斷言(!r.錯誤.includes('Invalid input'), '錯誤不應含英文 Invalid input')
    斷言(r.錯誤.includes('缺少'), '應使用中文「缺少」提示')
  }
}

console.log(`\n結果：${通過} 通過 / ${失敗} 失敗`)
if (失敗 > 0) process.exit(1)
