{
  "name": "yuhao-assess",
  "version": "1.0.0",
  "description": "宇浩測評網 - 輸入法性能測評工具",
  "type": "module",
  "engines": {
    "node": ">=24.2.0"
  },
  "scripts": {
    "fetch": "node scripts/fetch-data.mjs",
    "fetchlocal": "node scripts/fetch-local.js",
    "recompute": "tsx scripts/recompute-schemes.mts",
    "dev": "vite",
    "build": "node scripts/typecheck.mjs && vite build",
    "buildcf": "node scripts/build-cf.js",
    "typecheck": "node scripts/typecheck.mjs",
    "preview": "vite preview",
    "lint": "biome check .",
    "format": "biome format --write .",
    "tc": "node src/utils/normalize-traditional-chars.ts \"src/**/*.ts\" \"src/**/*.tsx\" \"docs/**/*.md\"",
    "cli": "tsx src/cli/index.ts",
    "test:e2e": "node tests/e2e/local-schemes.mjs",
    "prepare": "husky",
    "lint:fix": "biome check --write ."
  },
  "lint-staged": {
    "*.{ts,tsx}": ["node src/utils/normalize-traditional-chars.ts", "biome check --write"],
    "*.md": ["node src/utils/normalize-traditional-chars.ts", "markdownlint-cli2 --fix"],
    "*.{json,css}": ["biome format --write"]
  },
  "dependencies": {
    "@ant-design/icons": "^6.3.4",
    "antd": "^6.7.2",
    "jotai": "^3.0.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.7",
    "styled-components": "^6.7.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.9",
    "@types/node": "^26.6.10",
    "@types/react": "^19.3.3",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "husky": "^9.1.7",
    "jsonc-parser": "^3.3.1",
    "lint-staged": "^17.6.2",
    "markdownlint-cli2": "^0.24.2",
    "playwright": "^1.65.1",
    "tsx": "^4.23.15",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vite": "^8.3.8"
  }
}
